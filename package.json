	},
	"overrides": {
		"@grpc/grpc-js": "^1.14.6"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build:sw": "npx esbuild public/src/sw.js --bundle --outfile=public/sw.js --minify --format=iife",
		"build:sw:dist": "npx esbuild public/src/sw.js --bundle --outfile=dist/sw.js --minify --format=iife",
		"dev": "npm run build:sw && vite --host",
		"build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('public/maintenance.html', 'dist/maintenance.html')\" && npm run build:sw:dist",
		"preview": "vite preview",
		"version": "node scripts/update-version.js && git add public/src/config.ts",
		"seed:demo": "node scripts/seed-demo-data.js",
		"generate:receipt": "node scripts/generate-sample-receipt.js",
		"capture:screenshots": "node scripts/capture-screenshots.js",
		"record:videos": "node scripts/record-demo-videos.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arai-f/walletwise_journal.git"
	},
